          },
          {
            "html": "<div style=\"text-align:center;font-size:1.15rem\">Angle obtus : plus « ouvert » que l'angle droit.</div><div style=\"text-align:center;font-size:1.15rem;margin-top:8px\">&gt; 90°</div>",
