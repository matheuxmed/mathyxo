        "steps": [
          {
            "html": "<div style=\"text-align:center;font-size:1.3rem\">kilos : 2 → 4 → 6<br>prix : 6 → 12 → 18</div><div style=\"text-align:center;font-size:1.2rem;margin-top:8px\">6 ÷ 2 = 12 ÷ 4 = 18 ÷ 6 = 3</div>",
            "caption": { "fr": "Prix ÷ kilos donne toujours 3 : le coefficient est 3.", "ar": "الثمن ÷ الكيلو دائماً يعطي 3: المعامل هو 3." }
          },
          {
            "html": "<div style=\"text-align:center;font-size:1.3rem\">Pour compléter : kilos × 3 = prix</div><div style=\"text-align:center;font-size:1.2rem;margin-top:8px\">8 kilos → 8 × 3 = 24 €</div>",
            "caption": { "fr": "On multiplie chaque quantité par le coefficient.", "ar": "نضرب كل كمية في المعامل." }
          }
        ]
      },
      "example": {
        "type": "explainer",
        "prev": { "fr": "‹ Précédent", "ar": "‹ السابق" },
