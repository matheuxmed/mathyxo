        "steps": [
          {
            "html": "<div style=\"text-align:center;font-size:1.3rem\">3 stylos coûtent 6 €. Combien coûtent 6 stylos ?</div><div style=\"text-align:center;font-size:1.2rem;margin-top:8px\">Deux fois plus de stylos → deux fois plus cher : 12 €</div>",
            "caption": { "fr": "On dit que le prix est proportionnel au nombre de stylos.", "ar": "نقول أن الثمن يتناسب مع عدد الأقلام." }
          },
          {
            "html": "<div style=\"text-align:center;font-size:1.2rem\">Un tableau est proportionnel si on passe d'une colonne à l'autre en multipliant toujours par le même nombre.</div>",
            "caption": { "fr": "Ce nombre s'appelle le coefficient de proportionnalité.", "ar": "هذا العدد يسمى معامل التناسبية." }
          }
        ]
      },
      "example": {
