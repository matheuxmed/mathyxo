        "replay": { "fr": "↻ Revoir", "ar": "↻ إعادة" },
        "steps": [
          {
            "html": "<div style=\"text-align:center;font-size:1.2rem\">Bonbons : 2 → 4 € ; 4 → 8 € ; 6 → 12 €</div><div style=\"text-align:center;font-size:1.3rem;margin-top:8px\">Toujours × 2 → proportionnel ✓</div>",
            "caption": { "fr": "Chaque prix est 2 fois le nombre de bonbons : coefficient 2.", "ar": "كل ثمن يساوي ضعف عدد الحلوى: المعامل 2." }
          },
          {
            "html": "<div style=\"text-align:center;font-size:1.2rem\">Entrées : 1 → 5 € ; 2 → 9 € ; 4 → 16 €</div><div style=\"text-align:center;font-size:1.3rem;margin-top:8px\">×5 ? ×4.5 ? ×4 ? → pas proportionnel ✗</div>",
            "caption": { "fr": "Il n'y a pas toujours le même multiplicateur : ce n'est pas proportionnel.", "ar": "لا يوجد نفس المضاعف دائماً: إذن غير تناسبي." }
          }
        ]
      },
